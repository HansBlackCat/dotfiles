scan_timeout = 500
palette = "custom"

format = """
[](colorhostname)\
$os\
$hostname\
[](bg:color2 fg:colorhostname)\
$username\
[](fg:color2 bg:color3)\
$directory\
[](fg:color3 bg:color4)\
$git_branch\
$git_status\
[](fg:color4 bg:color5)\
$docker_context\
[](fg:color5 bg:color6)\
$time\
[ ](fg:color6)\
\n$character"""

# Disable the blank line at the start of the prompt
# add_newline = false

[palettes.custom]
{{- if eq .machineCode "31c76b52" }}
colorhostname = "#8F6FA8"
{{- else if eq .machineCode "78f1446d" }}
colorhostname = "#A86F7D"
{{- else if eq .machineCode "6ae79a60" }}
colorhostname = "#B7835A"
{{- else if eq .machineCode "ff514f36" }}
colorhostname = "#6F8F78"
{{- else if eq .machineCode "5" }}
colorhostname = "#5F8796"
{{- else }}
colorhostname = "#6F789E"
{{- end }}
#colorhostname1 = "#8F6FA8" # muted purple
#colorhostname2 = "#A86F7D" # dusty rose
#colorhostname3 = "#B7835A" # muted amber
#colorhostname4 = "#6F8F78" # sage green
#colorhostname5 = "#5F8796" # desaturated teal
#colorhostname6 = "#6F789E" # muted indigo
#color1 = "#9A348E"
color2 = "#B7A6B8"
color3 = "#C3A8AE"
color4 = "#D0B29C"
color5 = "#C6C2A5"
color6 = "#A9B9C8"
text = "#2B2D31"

#color1 = "#9A348E"
#color2 = "#DA627D"
#color3 = "#FCA17D"
#color4 = "#86BBD8"
#color5 = "#06969A"
#color6 = "#33658A"
#text = "#FFFFFF"

[hostname]
ssh_only = false
style = "bg:colorhostname fg:text"
format = '[ $hostname ]($style)'
trim_at = ""


# You can also replace your username with a neat symbol like   or disable this
# and use the os module below
[username]
show_always = true
style_user = "bg:color2 fg:text"
style_root = "bg:color2 fg:text"
format = '[ $user ]($style)'
disabled = false

# An alternative to the username module which displays a symbol that
# represents the current operating system
[os]
style = "bg:colorhostname fg:text"
disabled = false # Disabled by default

[os.symbols]
Windows = ""
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = "󰀵"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"

[directory]
style = "bg:color3 fg:text"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

# Here is how you can shorten some long paths by text replacement
# similar to mapped_locations in Oh My Posh:
[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "
# Keep in mind that the order matters. For example:
# "Important Documents" = " 󰈙 "
# will not be replaced, because "Documents" was already substituted before.
# So either put "Important Documents" before "Documents" or use the substituted version:
# "Important 󰈙 " = " 󰈙 "

[c]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[docker_context]
symbol = " "
style = "bg:color5 fg:text"
format = '[ $symbol $context ]($style)'

[elixir]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[elm]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[git_branch]
symbol = ""
style = "bg:color4 fg:text"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:color4 fg:text"
format = '[$all_status$ahead_behind ]($style)'

[golang]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[gradle]
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[haskell]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[java]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[julia]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[nodejs]
symbol = ""
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[nim]
symbol = "󰆥 "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[rust]
symbol = ""
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[scala]
symbol = " "
style = "bg:color4 fg:text"
format = '[ $symbol ($version) ]($style)'

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "bg:color6 fg:text"
format = '[ ♥ $time ]($style)'
